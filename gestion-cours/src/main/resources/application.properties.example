spring.application.name=gestion-cours
# Port du serveur backend
server.port=8080
# Connexion à la base MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/nom_bdd
spring.datasource.username=TON_USERNAME
spring.datasource.password=TON_MOT_DE_PASSE
# Hibernate crée/met à jour automatiquement la table à partir de l'entité Cours
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect